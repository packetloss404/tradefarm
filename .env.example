# EODHD market data — https://eodhd.com
EODHD_API_KEY=

# Alpaca paper trading — https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic (for LLM decision layer — optional until that module lands)
ANTHROPIC_API_KEY=

# App
DATABASE_URL=sqlite+aiosqlite:///./tradefarm.db
LOG_LEVEL=INFO
AGENT_COUNT=100
AGENT_STARTING_CAPITAL=1000

# Scheduler cadence. 300 (5 min) matches production; 0 disables auto-tick
# so only manual /tick fires. Leave blank to use the 300 default.
# AUTO_TICK_INTERVAL_SEC=300

# Optional shared secret for state-mutating endpoints. When set, every
# POST/PUT/PATCH/DELETE on the backend requires the header
#   X-TradeFarm-Token: <value>
# GETs (and /health, /market/clock, /openapi, /docs, /redoc) stay open,
# so the dashboard's polling keeps working unauthenticated.
#
# FAIL-FAST: if the API is bound to a non-loopback host (0.0.0.0 or a LAN
# IP) and this secret is EMPTY, the backend now refuses to start — so you
# can't accidentally expose the secret-rewriting endpoints to the LAN.
# Set this before running broadcast mode (npm run broadcast binds
# 0.0.0.0:8000). Local-only runs on 127.0.0.1 don't need it.
# API_SHARED_SECRET=

# Interface the API binds to. The startup guard reads the --host passed to
# uvicorn first; this is the fallback. 127.0.0.1 = local-only (safe with no
# secret). 0.0.0.0 / a LAN IP requires API_SHARED_SECRET (see above).
# API_BIND_HOST=127.0.0.1

# YouTube Live Chat — replaces the simulated audience strip with real messages
# from the active YouTube broadcast. Create a Desktop OAuth client in Google
# Cloud Console (APIs & Services -> Credentials), enable YouTube Data API v3,
# then run: `uv run python -m tradefarm.tools.youtube_auth` to capture the
# refresh token. Leave YOUTUBE_CHAT_ENABLED=false to keep the poller dormant.
YOUTUBE_CHAT_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
